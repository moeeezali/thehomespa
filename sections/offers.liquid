{{ 'offers.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .offers__grid {
    background: {{ section.settings.background_color }};
    background: linear-gradient({{ section.settings.gradient }});
  }

  .offers__item-content {
    background-color: {{ section.settings.content_background_color }};
    color: {{ section.settings.text_color }};
  }


  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-padding .offers__grid {
      grid-template-columns: repeat({{- section.blocks | size -}}, 1fr);
    }

    {%- if section.blocks.size == 1 -%}
      .section-{{ section.id }}-padding .offers__grid {
        padding: 0;
      }

      .section-{{ section.id }}-padding .offers__item-image {
        border-radius: 0;
        padding-bottom: 0;
        height: 100vh;
      }

      .section-{{ section.id }}-padding .offers__item-content {
        max-width: 50%;
        left: 25%;
        top: 40%;
        bottom: auto;
      }
    {%- endif -%}
  }
{%- endstyle -%}


<div class="isolate gradient">
  <div class="offers section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">

    <div class="container">
      <div class="offers__grid">
        {% for block in section.blocks %}
          <div class="offers__item">
            <div class="offers__item-inner">
              <div class="offers__item-image">
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}">
              </div>
              <div class="offers__item-content">
                <h3 class="offers__item-discount">{{ block.settings.discount }}</h3>
                <h3 class="offers__item-title">{{ block.settings.title }}</h3>
                <p class="offers__item-text">{{ block.settings.content }}</p>
                <a href="{{ block.settings.link }}" class="btn btn--secondary">{{ block.settings.button }}</a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Offers",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "label": "Background Color",
      "id": "background_color" 
    },
    {
      "type": "textarea",
      "id": "gradient",
      "label": "Gradient" 
    },
    {
      "type": "color",
      "label": "Content Background Color",
      "id": "content_background_color" 
    },
    {
      "type": "color",
      "label": "Text Color",
      "id": "text_color" 
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Discount"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offers"
    }
  ]
}
{% endschema %}
