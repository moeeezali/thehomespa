    "multicolumn_qH3p69": {
      "type": "multicolumn",
      "blocks": {
        "column_AqHk3r": {
          "type": "column",
          "settings": {
            "title": "<strong>5 cities</strong>",
            "text": "<p>We currently operate in several cities throughout the UAE, including Abu Dhabi, Dubai, Al Ain, Sharjah and Ajman with plans for further expansion.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_HY8WqG": {
          "type": "column",
          "settings": {
            "title": "<strong>40 employees</strong>",
            "text": "<p>Diversity is at our core, fostering an inclusive environment for our 40+ employees from diverse nationalities including UAE locals, British, Indians, Filipinos, Tunisians, Nepalese, Egyptians, and Russians.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_JDehi7": {
          "type": "column",
          "settings": {
            "title": "<strong>12 vehicles</strong>",
            "text": "<p>Given the unique demands of our home service spa and salon, The Home Spa now boasts a fleet of over 12 vehicles stationed across the UAE.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column_AqHk3r",
        "column_HY8WqG",
        "column_JDehi7"
      ],
      "settings": {
        "title": "Today,",
        "heading_size": "h2",
