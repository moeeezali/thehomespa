    "rich_text_waixBc": {
      "type": "rich-text",
      "blocks": {
        "heading_rbyRUJ": {
          "type": "heading",
          "settings": {
            "heading": "Self-love and self-care are priorities draped inluxury; still they are essential necessities.",
            "heading_size": "h2"
          }
        },
        "text_BCnnBk": {
          "type": "text",
          "settings": {
            "text": "<p>Pampering isn’t just a luxury; it’s a necessity. Recognizing the inherent importance of prioritizing oneself involves embracing moments of personal attention and investing in your well-being, allowing yourself to radiate confidence and vitality from within. That's why we bring accessible, high-quality services to your doorstep, offering everything from nail care to facials, hair styling, and massages, regardless of age or gender.</p>"
          }
        }
      },
      "block_order": [
        "heading_rbyRUJ",
        "text_BCnnBk"
      ],
      "settings": {
