    "multicolumn_JMtiPh": {
      "type": "multicolumn",
      "blocks": {
        "column_H9bXPK": {
          "type": "column",
          "settings": {
            "title": "Wellness",
            "text": "<p>Our services focus on holistic health — addressing physical, mental, and emotional well-being. It's a philosophy guiding individuals toward balance and fulfillment.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_8cwdVr": {
          "type": "column",
          "settings": {
            "title": "Connection",
            "text": "<p>Through personalized treatments and warm service, we aim to deepen clients' well- being, fostering a connection to the present moment that extends beyond the session.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_8h8WWK": {
          "type": "column",
          "settings": {
            "title": "Accessibility",
            "text": "<p>By breaking down barriers, we aim to create a space where individuals from various backgrounds and budgets can enjoy the rejuvenating effects of our services.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_aMDEm9": {
          "type": "column",
          "settings": {
            "title": "Exclusive",
            "text": "<p>We believe in empowering individuals of all ages and genders to express their authenticity and uniqueness. Beauty knows no boundaries with our services.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_4CAtCx": {
          "type": "column",
          "settings": {
            "title": "Quiet Luxury",
            "text": "<p>We prioritize subtle elegance over extravagance, creating spa experiences that offer a refined escape.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_qxTwXH": {
          "type": "column",
          "settings": {
            "title": "Time",
            "text": "<p>Your time is precious. Enjoy our convenient, high-quality services that eliminate salon visits, freeing up your valuable time.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
