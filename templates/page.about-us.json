    "multirow_hpfQD8": {
      "type": "multirow",
      "blocks": {
        "row_kmz8LE": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Photo_20-08-2024_6_24_27_PM.jpg",
            "caption": "",
            "heading": "Our Promise",
            "text": "<p>We proudly present an experience that embraces raw, unfiltered realness—no glossy facades, just genuine care. We are down-to-earth and humble, grounded in our love for self-care to spread beauty in all its shapes and colors. Here, it's not merely about beauty; it's a haven for mental and psychological well-being, a serene moment to reflect amidst life's hustle.</p><p>Our commitment extends to affordability, ensuring that our rejuvenating services are accessible to everyone. This is a space that transcends age and gender, inviting all to partake in the tranquility. Our spa is not just a one-time indulgence; it's an affordable service designed for regular moments of self-love. We promise an authentic, ageless, and all-inclusive retreat for the soul.</p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "row_kmz8LE"
      ],
