    "image_with_text_cnCxRQ": {
      "type": "image-with-text",
      "blocks": {
        "heading_cC44HP": {
          "type": "heading",
          "settings": {
            "heading": "How it all began",
            "heading_size": "h2"
          }
        },
        "text_mqAYKj": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Founded in May 2011, The Home Spa began with a focus on manicures and pedicures, later expanding its services to include hair, hair removal, body scrubs, massages, and more. This expansion led to its emergence as the leading provider of home beauty services in Abu Dhabi.</strong></p>",
            "text_style": "body"
          }
        },
        "caption_6rddUQ": {
          "type": "caption",
          "settings": {
            "caption": "The genesis of The Home Spa is deeply personal, rooted in theexperiences of our founder, Noura M. Al Ahbabi. As a new mothermanaging a demanding career, Noura epitomizes dedication, balancingresponsibilities at home and in the workplace. Recognizing the scarcityof self-care options, she founded The Home Spa with a vision to redefinewellness, envisioning it as a personal sanctuary within the home.",
            "text_style": "subtitle",
            "text_size": "small"
          }
        }
      },
      "block_order": [
        "heading_cC44HP",
        "text_mqAYKj",
        "caption_6rddUQ"
      ],
      "settings": {
